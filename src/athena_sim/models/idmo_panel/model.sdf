<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="idmo_panel">
    <static>true</static>
    <link name="link">
      <!-- Main upright panel (1.8m tall x 1.0m wide) -->
      <visual name="board">
        <pose>0 0 0.9 0 0 0</pose>
        <geometry><box><size>0.15 1.0 1.8</size></box></geometry>
        <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.4 0.45 0.5 1</diffuse></material>
      </visual>
      <collision name="board_col">
        <pose>0 0 0.9 0 0 0</pose>
        <geometry><box><size>0.15 1.0 1.8</size></box></geometry>
      </collision>
      <!-- Simulated optical QR / Code Target board on face -->
      <visual name="code_board">
        <pose>0.08 0 1.2 0 0 0</pose>
        <geometry><box><size>0.01 0.40 0.40</size></box></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>