<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="delivery_marker">
    <static>true</static>
    <link name="link">
      <!-- Base circular target pad on ground -->
      <visual name="pad">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry><cylinder><radius>0.75</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.1 0.7 0.9 1</ambient><diffuse>0.1 0.7 0.9 1</diffuse></material>
      </visual>
      <!-- Center vertical marker post -->
      <visual name="post">
        <pose>0 0 0.6 0 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>1.2</length></cylinder></geometry>
        <material><ambient>0.9 0.9 0.1 1</ambient><diffuse>0.9 0.9 0.1 1</diffuse></material>
      </visual>
      <collision name="post_col">
        <pose>0 0 0.6 0 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>1.2</length></cylinder></geometry>
      </collision>
    </link>
  </model>
</sdf>