<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="rado_hammer">
    <link name="link">
      <inertial>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.01</iyy><iyz>0</iyz><izz>0.002</izz>
        </inertia>
      </inertial>
      <!-- Handle (<= 7cm diameter) -->
      <collision name="handle_col">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.30</length></cylinder></geometry>
      </collision>
      <visual name="handle_vis">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.30</length></cylinder></geometry>
        <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
      </visual>
      <!-- Head -->
      <collision name="head_col">
        <pose>0 0 0.32 0 1.5708 0</pose>
        <geometry><box><size>0.05 0.12 0.05</size></box></geometry>
      </collision>
      <visual name="head_vis">
        <pose>0 0 0.32 0 1.5708 0</pose>
        <geometry><box><size>0.05 0.12 0.05</size></box></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>