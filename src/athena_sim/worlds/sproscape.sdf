    <!-- 5. ABEx Science Sample Cache Platform with orange/white markings -->
    <model name="abex_cache_platform">
      <static>true</static>
      <pose>15.0 -25.0 0.827 0.1134 -0.1023 0.0000</pose>
      <link name="link">
