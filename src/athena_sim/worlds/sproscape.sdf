          <pose>0.13 -0.15 1.45 0 0 0</pose>
          <geometry><sphere><radius>0.025</radius></sphere></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.2 1.0 0.2 1</diffuse><emissive>0.1 0.9 0.1 1</emissive></material>
        </visual>
