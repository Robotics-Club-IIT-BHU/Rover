          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
        </visual>
        <!-- Service Panel Console Face (width 0.8m, height 0.6m) -->
        <collision name="panel_col">
          <pose>0.05 0 1.25 0 0 0</pose>
