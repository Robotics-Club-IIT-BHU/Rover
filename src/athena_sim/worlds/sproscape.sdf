    <!-- 7. ABEx Crater Science Exploration Survey Stake -->
    <!-- ABEx Crater Science Outcrop Survey Stake -->
    <model name="crater_science_marker">
      <static>true</static>
      <pose>-25.000 20.000 0.215 0 0 0</pose>
      <link name="link">
        <visual name="stake_pole">
