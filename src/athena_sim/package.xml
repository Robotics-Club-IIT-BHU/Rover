<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>athena_sim</name>
  <version>0.1.0</version>
  <description>
    Simulation harness for Athena rover in Gazebo Fortress (gz-sim 6).
    Provides procedural Mars-analog arena (Sproscape-Sim), realistic sensor
    adapters (RTK GNSS error model, VIO emulator, depth camera bridge),
    six-wheel skid-steer drivetrain integration, and IRC 2027 mission
    clock and scoring tools.
  </description>
  <maintainer email="jashanpreetsinghbrar01@gmail.com">Jashan</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>athena_gps_nav</exec_depend>
  <exec_depend>athena_drive</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
