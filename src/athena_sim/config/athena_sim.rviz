Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /RobotModel1
        - /Odometry local1
        - /Odometry global (GPS Fused)1
        - /Depth Cloud (Downsampled)1
        - /Local Costmap1
        - /Global Costmap1
        - /Nav2 Plan1
      Splitter Ratio: 0.55
    Tree Height: 550
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Nav2 Goal1
    Name: Tool Properties
    Splitter Ratio: 0.58
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Plane Cell Count: 30
      Color: 140; 140; 140
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.6
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        base_link:
          Value: true
        odom:
          Value: true
        map:
          Value: true
        camera_link:
          Value: true
        imu_link:
          Value: true
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1.0
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odometry local
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/local
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Keep: 400
      Shape:
        Alpha: 0.9
        Axes Length: 0.3
        Axes Radius: 0.03
        Color: 0; 200; 100
        Head Length: 0.1
        Head Radius: 0.05
        Shaft Length: 0.3
        Shaft Radius: 0.02
        Value: Arrow
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odometry global (GPS Fused)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/global
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Keep: 400
      Shape:
        Alpha: 1.0
        Axes Length: 0.4
        Axes Radius: 0.04
        Color: 255; 110; 25
        Head Length: 0.12
        Head Radius: 0.06
        Shaft Length: 0.35
        Shaft Radius: 0.03
        Value: Arrow
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: false
      Name: VIO Raw
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vio/odometry
      Keep: 200
      Shape:
        Color: 80; 120; 230
        Value: Arrow
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Depth Cloud (Downsampled)
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/camera/depth/color/points_downsampled
      Size (m): 0.02
      Style: Flat Squares
      Color Transformer: AxisColor
      Value: true
    - Class: rviz_default_plugins/Map
      Alpha: 0.7
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Local Costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Update Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap_updates
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/Map
      Alpha: 0.4
      Color Scheme: costmap
      Draw Behind: true
      Enabled: true
      Name: Global Costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Update Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap_updates
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Nav2 Plan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Color: 255; 85; 0
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Nav2 Smoothed Plan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan_smoothed
      Color: 0; 220; 255
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Onboard RealSense Color
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/camera/color/image_raw
      Value: false
  Global Options:
    Background Color: 33; 36; 39
    Fixed Frame: odom
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: nav2_rviz_plugins/GoalTool
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0.3
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.8
      Target Frame: base_link
      Value: Orbit (rviz_default_plugins)
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  X: 100
  Y: 100
