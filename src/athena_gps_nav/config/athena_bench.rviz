Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Local Costmap1
        - /Odometry local1
      Splitter Ratio: 0.55
    Tree Height: 500
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Plane Cell Count: 20
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.7
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        base_link:
          Value: true
        odom:
          Value: true
        map:
          Value: true
        camera_link:
          Value: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odometry local
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/local
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Keep: 300
      Shape:
        Alpha: 1
        Axes Length: 0.3
        Axes Radius: 0.03
        Color: 0; 170; 90
        Head Length: 0.1
        Head Radius: 0.05
        Shaft Length: 0.3
        Shaft Radius: 0.02
        Value: Arrow
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odometry global
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/global
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Keep: 300
      Shape:
        Alpha: 1
        Axes Length: 0.3
        Axes Radius: 0.03
        Color: 230; 90; 40
        Head Length: 0.1
        Head Radius: 0.05
        Shaft Length: 0.3
        Shaft Radius: 0.02
        Value: Arrow
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: false
      Name: VIO raw
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vio/odometry
      Keep: 300
      Shape:
        Color: 80; 120; 230
        Value: Arrow
      Value: false
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Local Costmap
      Color Scheme: costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Update Topic:
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /local_costmap/costmap_updates
      Value: true
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: Global Costmap
      Color Scheme: costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Update Topic:
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /global_costmap/costmap_updates
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Depth Cloud
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/camera/depth/color/points_downsampled
      Size (m): 0.02
      Style: Flat Squares
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Camera
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/camera/color/image_raw
      Value: false
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Nav2 Plan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Color: 230; 90; 40
      Value: true
  Global Options:
    Background Color: 33; 36; 39
    Fixed Frame: odom
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Name: Current View
      Pitch: 0.9
      Target Frame: base_link
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
