<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="athena">

  <xacro:arg name="sim" default="false"/>
  <xacro:property name="is_sim" value="$(arg sim)"/>

  <!--
    Athena rover description.

    This file does two jobs and only one of them matters to navigation:

      1. It places the SENSOR FRAMES.  camera_link is where the costmap
         believes every depth point came from, imu_link is where the EKF
         believes the gyro is, gps_link is where navsat_transform believes
         the antenna is.  These are load-bearing.  Measure them, do not
         guess them.

      2. It draws a rover.  The body, wheels and nose block are cosmetic.
         Nothing reads them.  They exist because a recognisable shape makes
         it obvious at a glance which way the rover is facing.

    Frame tree this produces:

        odom  (ekf_local owns this link)
          |
        base_link ...... chassis centre, base_height above the ground
          |- base_footprint  ground projection
          |- camera_link     RealSense D435i    <- drives obstacle avoidance
          |- imu_link        Pixhawk            <- drives the EKF yaw rate
          |- gps_link        GPS antenna        <- drives navsat_transform
          |- nose_marker, wheel_* x6   (visual only)

    Editing rule: XML comments cannot contain a double hyphen anywhere, not
    just at the end.  xacro fails with a "not well-formed (invalid token)"
    error that points at the comment, not at the real problem.  Use a single
    hyphen or a comma.
  -->

  <!-- =====================================================================
       MEASURED NUMBERS.  Everything below is derived from these.
       Each one says how it was established.  If you change the hardware,
       change it here, then rebuild athena_gps_nav from the workspace root
       with a symlink install (see CONTRIBUTING.md) and relaunch.
       ===================================================================== -->

  <!-- Chassis. Measured for Athena competition rover:
       Avionics/chassis box is 28cm high, 54cm wide, 85cm long.
       Base_link is origin; ground is at -base_height = -0.25m. -->
  <xacro:property name="base_length"     value="0.85"/>  <!-- x, front to back -->
  <xacro:property name="base_width"      value="0.54"/>  <!-- y, side to side  -->
  <xacro:property name="base_height"     value="0.25"/>  <!-- ground to base_link with 30cm wheels -->
  <xacro:property name="chassis_height"  value="0.28"/>  <!-- 28 cm chassis box height -->
  <xacro:property name="track_width"     value="0.85"/>  <!-- wheel centre to centre -->

  <!-- Camera: RealSense D435i mounted at top of chassis at front centre.
       Lens is at x = 0.50 (front face of chassis), z = 0.40 (top deck of chassis,
       which sits 0.65 m above the ground: 0.40 - (-0.25) = 0.65 m). -->
  <xacro:property name="camera_x"     value="0.50"/>
  <xacro:property name="camera_z"     value="0.40"/>
  <!-- Camera tilt about its own left axis, radians. 0.0 for level mounting. -->
  <xacro:property name="camera_pitch" value="0.0"/>

  <!-- Pixhawk IMU: inside front avionics bay, 15 cm below depth camera. -->
  <xacro:property name="imu_x"        value="${camera_x}"/>
  <xacro:property name="imu_z"        value="${camera_z - 0.15}"/>
  <xacro:property name="imu_roll"     value="0.0"/>
  <xacro:property name="imu_pitch"    value="0.0"/>
  <xacro:property name="imu_yaw"      value="0.0"/>

  <!-- GPS antenna: mounted on top deck of chassis at z = 0.41 m. -->
  <xacro:property name="gps_x"        value="0.0"/>
  <xacro:property name="gps_y"        value="0.0"/>
  <xacro:property name="gps_z"        value="${camera_z + 0.01}"/>

  <!-- Wheel dimensions: 30 cm diameter (radius 0.15 m), 8 cm width -->
  <xacro:property name="wheel_radius"    value="0.15"/>  <!-- 30 cm diameter -->
  <xacro:property name="wheel_width"     value="0.08"/>  <!-- 8 cm width -->
  <xacro:property name="wheel_x"         value="0.45"/>  <!-- front/rear axle offset -->

  <!-- Rocker-Bogie main pivot: at the lower end of the chassis (28 cm below camera) -->
  <xacro:property name="rocker_pivot_x"  value="0.05"/>
  <xacro:property name="rocker_pivot_z"  value="${camera_z - chassis_height}"/>

  <material name="athena_body">  <color rgba="0.22 0.25 0.28 1.0"/></material>
  <material name="athena_accent"><color rgba="0.31 0.75 0.80 1.0"/></material>
  <material name="athena_wheel"> <color rgba="0.10 0.10 0.11 1.0"/></material>
  <material name="athena_gps">   <color rgba="0.95 0.72 0.20 1.0"/></material>
  <material name="athena_rocker"><color rgba="0.18 0.20 0.22 1.0"/></material>

  <!-- ==== chassis ======================================================= -->

  <link name="base_link">
    <!-- Main central avionics & battery chassis body (28cm high) -->
    <visual>
      <origin xyz="0.075 0 0.26" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${chassis_height}"/></geometry>
      <material name="athena_body"/>
    </visual>
    <!-- Top equipment deck -->
    <visual>
      <origin xyz="0.05 0 0.401" rpy="0 0 0"/>
      <geometry><box size="0.75 0.50 0.005"/></geometry>
      <material name="athena_accent"/>
    </visual>
    <!-- Transverse rocker pivot axle tube extending across lower end of chassis -->
    <visual>
      <origin xyz="${rocker_pivot_x} 0 ${rocker_pivot_z}" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.025" length="${track_width}"/></geometry>
      <material name="athena_rocker"/>
    </visual>
    <xacro:if value="${is_sim}">
      <collision>
        <origin xyz="0.075 0 0.26" rpy="0 0 0"/>
        <geometry><box size="${base_length} ${base_width} ${chassis_height}"/></geometry>
      </collision>
      <inertial>
        <mass value="35.0"/>
        <origin xyz="0.05 0 0.24" rpy="0 0 0"/>
        <inertia ixx="${35.0 * (base_width*base_width + chassis_height*chassis_height) / 12.0}"
                 ixy="0.0" ixz="0.0"
                 iyy="${35.0 * (base_length*base_length + chassis_height*chassis_height) / 12.0}"
                 iyz="0.0"
                 izz="${35.0 * (base_length*base_length + base_width*base_width) / 12.0}"/>
      </inertial>
    </xacro:if>
  </link>

  <xacro:if value="${is_sim}">
    <gazebo reference="base_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>0.5</mu1>
      <mu2>0.5</mu2>
    </gazebo>
  </xacro:if>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="base_footprint"/>
    <origin xyz="0 0 ${-base_height}" rpy="0 0 0"/>
  </joint>

  <!-- Front nose marker block for unmistakable orientation -->
  <link name="nose_marker">
    <visual>
      <geometry><box size="0.04 ${base_width * 0.7} 0.08"/></geometry>
      <material name="athena_accent"/>
    </visual>
    <xacro:if value="${is_sim}">
      <collision>
        <geometry><box size="0.04 ${base_width * 0.7} 0.08"/></geometry>
      </collision>
    </xacro:if>
  </link>
  <joint name="nose_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="nose_marker"/>
    <origin xyz="0.51 0 0.32" rpy="0 0 0"/>
  </joint>

  <!-- ==== rocker-bogie suspension and six wheels ====================== -->

  <xacro:macro name="rocker_bogie_assembly" params="side y_sign">
    <!-- Rocker link and main pivot joint -->
    <link name="rocker_${side}">
      <!-- Pivot hub cylinder -->
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.035" length="0.06"/></geometry>
        <material name="athena_rocker"/>
      </visual>
      <!-- Beam from pivot forward and down to front wheel -->
      <visual>
        <origin xyz="0.20 0 -0.11" rpy="0 0.502 0"/>
        <geometry><box size="0.456 0.04 0.04"/></geometry>
        <material name="athena_rocker"/>
      </visual>
      <!-- Beam from pivot backward and down to bogie joint -->
      <visual>
        <origin xyz="-0.10 0 -0.06" rpy="0 -0.540 0"/>
        <geometry><box size="0.233 0.04 0.04"/></geometry>
        <material name="athena_rocker"/>
      </visual>
      <!-- Bogie joint housing hub -->
      <visual>
        <origin xyz="-0.20 0 -0.12" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.03" length="0.05"/></geometry>
        <material name="athena_rocker"/>
      </visual>
      <xacro:if value="${is_sim}">
        <collision>
          <origin xyz="0.20 0 -0.11" rpy="0 0.502 0"/>
          <geometry><box size="0.456 0.04 0.04"/></geometry>
        </collision>
        <inertial>
          <mass value="3.0"/>
          <origin xyz="0.10 0 -0.08" rpy="0 0 0"/>
          <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.08" iyz="0.0" izz="0.08"/>
        </inertial>
      </xacro:if>
    </link>

    <xacro:unless value="${is_sim}">
      <joint name="rocker_${side}_joint" type="fixed">
        <parent link="base_link"/>
        <child  link="rocker_${side}"/>
        <origin xyz="${rocker_pivot_x} ${y_sign * track_width/2} ${rocker_pivot_z}" rpy="0 0 0"/>
      </joint>
    </xacro:unless>

    <xacro:if value="${is_sim}">
      <joint name="rocker_${side}_joint" type="revolute">
        <parent link="base_link"/>
        <child  link="rocker_${side}"/>
        <origin xyz="${rocker_pivot_x} ${y_sign * track_width/2} ${rocker_pivot_z}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.45" upper="0.45" effort="120.0" velocity="5.0"/>
        <dynamics damping="1.0" friction="0.5"/>
      </joint>
    </xacro:if>

    <!-- Bogie link and pivot joint -->
    <link name="bogie_${side}">
      <!-- Bogie center pivot hub -->
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.03" length="0.055"/></geometry>
        <material name="athena_rocker"/>
      </visual>
      <!-- Beam from bogie pivot forward and down to mid wheel -->
      <visual>
        <origin xyz="0.075 0 -0.05" rpy="0 0.588 0"/>
        <geometry><box size="0.18 0.035 0.035"/></geometry>
        <material name="athena_rocker"/>
      </visual>
      <!-- Beam from bogie pivot backward and down to rear wheel -->
      <visual>
        <origin xyz="-0.15 0 -0.05" rpy="0 -0.322 0"/>
        <geometry><box size="0.316 0.035 0.035"/></geometry>
        <material name="athena_rocker"/>
      </visual>
      <xacro:if value="${is_sim}">
        <collision>
          <origin xyz="-0.075 0 -0.05" rpy="0 0 0"/>
          <geometry><box size="0.48 0.035 0.035"/></geometry>
        </collision>
        <inertial>
          <mass value="2.5"/>
          <origin xyz="-0.075 0 -0.05" rpy="0 0 0"/>
          <inertia ixx="0.015" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.05"/>
        </inertial>
      </xacro:if>
    </link>

    <xacro:unless value="${is_sim}">
      <joint name="bogie_${side}_joint" type="fixed">
        <parent link="rocker_${side}"/>
        <child  link="bogie_${side}"/>
        <origin xyz="-0.20 0.0 -0.12" rpy="0 0 0"/>
      </joint>
    </xacro:unless>

    <xacro:if value="${is_sim}">
      <joint name="bogie_${side}_joint" type="revolute">
        <parent link="rocker_${side}"/>
        <child  link="bogie_${side}"/>
        <origin xyz="-0.20 0.0 -0.12" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.45" upper="0.45" effort="100.0" velocity="5.0"/>
        <dynamics damping="1.0" friction="0.5"/>
      </joint>
    </xacro:if>

    <!-- Front Wheel attached to Rocker (x=0.45, z=-0.10 in base_link) -->
    <xacro:wheel_instance name="wheel_front_${side}" parent="rocker_${side}"
                          x="0.40" y="0.0" z="-0.22"/>

    <!-- Mid Wheel attached to Bogie (x=0.00, z=-0.10 in base_link) -->
    <xacro:wheel_instance name="wheel_mid_${side}" parent="bogie_${side}"
                          x="0.15" y="0.0" z="-0.10"/>

    <!-- Rear Wheel attached to Bogie (x=-0.45, z=-0.10 in base_link) -->
    <xacro:wheel_instance name="wheel_rear_${side}" parent="bogie_${side}"
                          x="-0.30" y="0.0" z="-0.10"/>
  </xacro:macro>

  <!-- Wheel instance macro (30 cm diameter, 3.5 kg mass) -->
  <xacro:macro name="wheel_instance" params="name parent x y z">
    <link name="${name}">
      <!-- Outer treaded tire -->
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="athena_wheel"/>
      </visual>
      <!-- Inner accent hubcap -->
      <visual>
        <geometry><cylinder radius="${wheel_radius * 0.60}" length="${wheel_width + 0.004}"/></geometry>
        <material name="athena_accent"/>
      </visual>
      <xacro:if value="${is_sim}">
        <collision>
          <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        </collision>
        <inertial>
          <mass value="3.5"/>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <inertia ixx="0.0215" ixy="0.0" ixz="0.0"
                   iyy="0.0215" iyz="0.0"
                   izz="0.0394"/>
        </inertial>
      </xacro:if>
    </link>

    <xacro:unless value="${is_sim}">
      <joint name="${name}_joint" type="fixed">
        <parent link="${parent}"/>
        <child  link="${name}"/>
        <origin xyz="${x} ${y} ${z}" rpy="1.5708 0 0"/>
      </joint>
    </xacro:unless>

    <xacro:if value="${is_sim}">
      <joint name="${name}_joint" type="continuous">
        <parent link="${parent}"/>
        <child  link="${name}"/>
        <origin xyz="${x} ${y} ${z}" rpy="1.5708 0 0"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.08" friction="0.05"/>
        <limit effort="50.0" velocity="20.0"/>
      </joint>
      <gazebo reference="${name}">
        <material>Gazebo/Black</material>
        <mu1>1.0</mu1>
        <mu2>0.2</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.005</minDepth>
      </gazebo>
    </xacro:if>
  </xacro:macro>

  <xacro:rocker_bogie_assembly side="left"  y_sign="1"/>
  <xacro:rocker_bogie_assembly side="right" y_sign="-1"/>

  <!-- ==== sensors ======================================================= -->

  <!-- RealSense D435i mounted at top of chassis at front centre -->
  <link name="camera_link">
    <!-- Camera head -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.025 0.09 0.025"/></geometry>
      <material name="athena_accent"/>
    </visual>
    <!-- Camera mount pedestal to chassis top deck -->
    <visual>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry><box size="0.04 0.06 0.015"/></geometry>
      <material name="athena_body"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${camera_x} 0 ${camera_z}" rpy="0 ${camera_pitch} 0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="${imu_x} 0 ${imu_z}"
            rpy="${imu_roll} ${imu_pitch} ${imu_yaw}"/>
  </joint>

  <link name="gps_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
      <material name="athena_gps"/>
    </visual>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="gps_link"/>
    <origin xyz="${gps_x} ${gps_y} ${gps_z}" rpy="0 0 0"/>
  </joint>

</robot>
