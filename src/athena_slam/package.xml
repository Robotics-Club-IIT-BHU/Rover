<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>athena_slam</name>
  <version>0.0.0</version>
  <description>Visual SLAM and point cloud processing for Athena rover using RTAB-Map and RealSense</description>
  <maintainer email="thomas.j.chackenkulam295@gmail.com">robo</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>rtabmap_ros</depend>
  <depend>realsense2_camera</depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
